APP_NAME=ai-codebase-assistant
API_V1_PREFIX=/api/v1
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Default local development profile: SQLite, no Docker required.
APP_ENV=local
DATABASE_URL=sqlite:///./storage/app.db

# Future production PostgreSQL profile:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

REPOSITORY_STORAGE_DIR=./storage/repositories
UPLOAD_STORAGE_DIR=./storage/uploads

MAX_UPLOAD_SIZE_MB=200
MAX_FILE_SIZE_MB=1

LLM_PROVIDER=fake
LLM_MODEL=fake-chat-model
LLM_API_KEY=

EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embedding-model
EMBEDDING_API_KEY=

VECTOR_STORE_PROVIDER=local
ENABLE_AGENT_TRACE=true
